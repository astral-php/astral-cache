# astral-cache — fusionner dans le .env de l'application
CACHE_DRIVER=file
CACHE_PREFIX=astral:
CACHE_TTL=3600

# file | core — chemin absolu recommandé, hors web public
# CACHE_PATH=/var/www/site/storage/cache

# redis (ext-redis) — clear() = SCAN préfixe, jamais FLUSHDB
# CACHE_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# memcache (ext-memcache Windows/Laragon) ou memcached (Linux)
# CACHE_DRIVER=memcache
# MEMCACHE_HOST=127.0.0.1
# MEMCACHE_PORT=11211
